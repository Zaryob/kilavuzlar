{% for item in searchable %}
  {"lang": {{ item.lang | default: 'tr' | jsonify }}, "title": {{ item.title | jsonify }}, "url": {{ item.url | relative_url | jsonify }}, "type": {% if item.status == 'arsiv' %}"kılavuzlar/arşiv/"{% else %}"kılavuzlar/"{% endif %}, "description": {{ item.scope | default: item.title | jsonify }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
